+def tiny_blocks():
+    return [{'input_ids': [i, 1, 0], 'document_ids': [0, 0, -1],
+             'position_ids': [0, 1, 0], 'valid': [True, True, False],
+             'labels': {1: [1, -100, -100], 2: [-100, -100, -100]}}
+            for i in range(2)]
