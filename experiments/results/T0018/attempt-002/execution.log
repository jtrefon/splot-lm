import json
from pathlib import Path
from speculation_trace import SCHEMA, synthetic_fixtures, summarize
cases = {}
for name, events in synthetic_fixtures().items():
    cases[name] = {"events": events, "summary": summarize(events, synthetic=True)}
payload = {
    "schema": SCHEMA,
    "synthetic": True,
    "timing": "fake_clock_ns",
    "note": "Synthetic reducer fixtures only; timestamps are injected fake-clock values and are not performance measurements.",
    "cases": cases,
}
Path("experiments/results/T0018/attempt-002/trace-fixtures.json").write_text(
    json.dumps(payload, indent=2, sort_keys=True, allow_nan=False) + "\n",
    encoding="utf-8")
print("fixture cases", len(cases))
for name, case in cases.items():
    summary = case["summary"]
    print(name, summary["rounds"], summary["proposed_tokens"],
          summary["accepted_tokens"], summary["rejected_tokens"],
          summary["unexamined_tokens"], summary["committed_tokens"],
          summary["work"]["target_calls"], summary["work"]["shallow_calls"],
          summary["timing"]["decode_seconds"])

