{
  "model_family": "splot",
  "dense": {
    "vocab_size": 16384,
    "width": 384,
    "layers": 8,
    "q_heads": 6,
    "kv_heads": 2,
    "head_dim": 64,
    "intermediate": 1024,
    "rope_theta": 1000000,
    "eps": 0.00001,
    "init_std": 0.02
  },
  "recurrence": {
    "prelude": 2,
    "core": 4,
    "coda": 2,
    "max_loops": 4,
    "default_loops": 2,
    "injection": "none",
    "injection_strength": 0.1,
    "residual_scale": "unscaled",
    "depth_embedding": false,
    "gdn_algorithm": "chunk64"
  },
  "expert_intermediate": 512,
  "training": {
    "data": "pilot-blocks-v1",
    "precision": "fp32",
    "mode": "A0",
    "loops": 2,
    "seed": 43,
    "sequence_length": 512,
    "batch_size": 1,
    "lr": 0.003,
    "weight_decay": 0,
    "depth_weight": 0,
    "offset_weight": 0,
    "balance_weight": 0.01,
    "optimizer": {
      "name": "muon",
      "muon": {
        "lr": 0.003,
        "weight_decay": 0.0,
        "momentum": 0.95,
        "nesterov": true,
        "ns_coefficients": [3.4445, -4.775, 2.0315],
        "ns_steps": 5,
        "eps": 1e-07,
        "adjust_lr_fn": "match_rms_adamw"
      },
      "adamw": {
        "lr": 0.003,
        "weight_decay": 0.0,
        "betas": [0.9, 0.999],
        "eps": 1e-08
      }
    },
    "checkpoint_interval": 1
  }
}
